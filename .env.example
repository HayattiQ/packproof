# ---------------------------------------------------------------------------
# PackProof environment configuration
#
# Everything defaults to deterministic MOCK adapters so the app typechecks,
# builds, and runs end-to-end with NO secrets and NO network access.
# Only set the "real" values below when you intentionally want to talk to
# PSA / OpenAI Vision / a live Mantle RPC.
# ---------------------------------------------------------------------------

# --- Chain (public; read by browser) ---------------------------------------
# Mantle Sepolia testnet = 5003 (default for the demo). Mantle mainnet = 5000.
NEXT_PUBLIC_CHAIN_NAME=Mantle Sepolia
NEXT_PUBLIC_MANTLE_CHAIN_ID=5003

# Deployed PackProof contract addresses (set after the contracts domain runs
# contracts/script/Deploy.s.sol). The system is four contracts. A zero address
# for a given contract => its operations run in SIMULATED mode (no real tx).
NEXT_PUBLIC_EXTERNAL_CARD_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ATTESTATION_LOG_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PACK_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REWARD_NFT_ADDRESS=0x0000000000000000000000000000000000000000
# Optional treasury address (pack sale proceeds recipient) for reference.
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional explorer base used to render txhash links in the UI.
NEXT_PUBLIC_MANTLE_EXPLORER_URL=https://sepolia.mantlescan.xyz

# --- RPC --------------------------------------------------------------------
# Server-side RPC endpoint. Leave blank to use the chain default public RPC.
# If reads fail or the contract address is zero, the client SIMULATES.
MANTLE_RPC_URL=

# --- Relayer (server-only; sponsored signing / no-wallet happy path) --------
# When RELAYER_PRIVATE_KEY is ABSENT, every write returns a SIMULATED receipt
# (deterministic fake txhash) so the happy path works with no secrets.
# NEVER commit a real key. 0x-prefixed 32-byte hex.
RELAYER_PRIVATE_KEY=

# --- Adapter selection ------------------------------------------------------
# Comma-separated set of REAL adapters to enable. Anything not listed uses the
# deterministic mock. Default (empty / "mock") => all mocks.
# Recognized tokens: vision | phash | comps | official
# Examples:
#   PACKPROOF_ADAPTERS=mock                 # all mock (default)
#   PACKPROOF_ADAPTERS=phash,comps          # real perceptual-hash + comps table
#   PACKPROOF_ADAPTERS=vision,official      # real OCR + real PSA lookup
PACKPROOF_ADAPTERS=mock

# --- Real adapter credentials (only needed when enabled above) --------------
# OpenAI-compatible Vision endpoint for the real OCR adapter ("vision").
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# PSA public cert-verification API token for the real PSA adapter ("official").
PSA_API_TOKEN=
PSA_API_BASE_URL=https://api.psacard.com/publicapi

# --- Compliance ------------------------------------------------------------
# Value (USD) at or above which a registration triggers enhanced KYC/diligence.
COMPLIANCE_ENHANCED_KYC_USD_THRESHOLD=5000
# Comma-separated ISO country codes blocked from registration/trade.
COMPLIANCE_RESTRICTED_JURISDICTIONS=IR,KP,SY,CU
